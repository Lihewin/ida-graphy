import sys
import argparse
import os
import importlib

def main():
    # 1. 解析命令行参数
    parser = argparse.ArgumentParser(description="Use idalib to analyze a binary and run INP.py")
    parser.add_argument("binary", help="Path to the binary file")
    args = parser.parse_args()

    binary_path = os.path.abspath(args.binary)
    if not os.path.exists(binary_path):
        print(f"Error: File {binary_path} not found.")
        return

    # 2. 尝试导入 idalib 和相关模块
    try:
        import idapro as idalib
        import ida_auto
    except ImportError:
        # 自动尝试添加 IDA 路径
        ida_path = r"C:\Program Files\IDA Professional 9.2"
        sys.path.append(os.path.join(ida_path, "python"))
        sys.path.append(os.path.join(ida_path, r"idalib\python"))
        try:
            import idapro as idalib
            import ida_auto
        except ImportError:
            print("Error: idalib not found. Please ensure IDA 9.0+ is installed and idalib is in your Python path.")
            return

    # 3. 使用 idalib 打开二进制文件
    print(f"[*] Opening binary: {binary_path}")
    # open_database 会根据文件扩展名决定是打开已有的 IDB 还是加载并创建新的 IDB
    # 在 IDA 9.2 idalib 中:
    # 0: 成功
    # -1: 无法打开 IDB
    # -2: 无法从输入文件加载/创建数据库
    result = idalib.open_database(binary_path, True)
    if result == 0:
        try:
            # 4. 运行 INP.py 执行 IDA 操作
            print("[*] Running INP.py...")
            # 将当前目录加入 path 以便导入 INP
            script_dir = os.path.dirname(os.path.abspath(__file__))
            if script_dir not in sys.path:
                sys.path.append(script_dir)
            
            import INP
            # 重新加载以确保运行的是最新版本
            importlib.reload(INP)
            INP.main()

        except Exception as e:
            print(f"[!] Error during execution: {e}")
            import traceback
            traceback.print_exc()
        finally:
            # 5. 最后关闭文件（不保存 IDB）
            print("[*] Closing database (without saving)...")
            idalib.close_database(False)

            # 6. 清理临时数据库文件 (.id0, .id1, .id2, .nam, .til 等)
            db_base = os.path.splitext(binary_path)[0]
            # 如果是已经存在 idb 的情况，扩展名可能是 .i64 或 .idb
            input_ext = os.path.splitext(binary_path)[1].lower()
            if input_ext in ['.i64', '.idb']:
                db_base = os.path.splitext(binary_path)[0]
            
            temp_exts = ['.id0', '.id1', '.id2', '.nam', '.til', '.unp']
            for ext in temp_exts:
                temp_file = db_base + ext
                if os.path.exists(temp_file):
                    try:
                        os.remove(temp_file)
                        print(f"[*] Cleaned up: {os.path.basename(temp_file)}")
                    except Exception as e:
                        print(f"[!] Failed to delete {temp_file}: {e}")
    else:
        print(f"[!] Failed to open database for: {binary_path}")

if __name__ == "__main__":
    main()
