# ida_export_for_ai.py
# IDAPython script to export decompiled functions, strings, memory, imports and exports for AI analysis
# 适用于 IDA 9.0+ 环境 (idalib)

import os
import ida_hexrays
import ida_funcs
import ida_nalt
import ida_xref
import ida_segment
import ida_bytes
import ida_entry
import idautils
import idc
import ida_typeinf
import ida_auto
import hashlib

# IDA 9.0+ 中结构体功能通过 ida_typeinf 实现
HAS_STRUCT_SUPPORT = True

# 性能优化：预计算 ASCII 映射表
_ASCII_TRANS = bytes([b if 0x20 <= b <= 0x7E else ord('.') for b in range(256)])


def get_idb_directory():
    """获取 IDB 文件所在目录"""
    idb_path = ida_nalt.get_input_file_path()
    if not idb_path:
        import ida_loader
        idb_path = ida_loader.get_path(ida_loader.PATH_TYPE_IDB)
    return os.path.dirname(idb_path) if idb_path else os.getcwd()

def ensure_dir(path):
    """确保目录存在"""
    if not os.path.exists(path):
        os.makedirs(path)

def build_call_graph(func_list):
    """构建全局调用图，优化版
    
    使用 FuncItems 代替 Heads 并增加函数查找缓存以提升性能
    """
    print("[*] Building call graph for {} functions...".format(len(func_list)))
    
    callers_map = {ea: set() for ea in func_list}
    callees_map = {ea: set() for ea in func_list}
    func_set = set(func_list)
    
    # 缓存函数地址查找结果，减少 API 调用
    func_cache = {}
    
    processed = 0
    for func_ea in func_list:
        # 使用 FuncItems 获取所有指令地址，效率更高且处理非连贯函数更准确
        for head in idautils.FuncItems(func_ea):
            for ref in idautils.XrefsFrom(head, 0):
                if ref.type in (ida_xref.fl_CF, ida_xref.fl_CN):
                    callee_ea = ref.to
                    if callee_ea not in func_cache:
                        f = ida_funcs.get_func(callee_ea)
                        func_cache[callee_ea] = f.start_ea if f else None
                    
                    callee_start = func_cache[callee_ea]
                    if callee_start and callee_start in func_set:
                        callees_map[func_ea].add(callee_start)
                        callers_map[callee_start].add(func_ea)
        
        processed += 1
        if processed % 1000 == 0:
            print("[+] Call graph: processed {}/{} functions...".format(processed, len(func_list)))
    
    # 转换为排序列表
    callers_map = {ea: sorted(list(callers)) for ea, callers in callers_map.items()}
    callees_map = {ea: sorted(list(callees)) for ea, callees in callees_map.items()}
    
    print("[+] Call graph built successfully")
    return callers_map, callees_map

def get_callers(func_ea):
    """获取调用当前函数的地址列表（向后兼容，不推荐使用）"""
    callers = []
    for ref in idautils.XrefsTo(func_ea, 0):
        if idc.is_code(idc.get_full_flags(ref.frm)):
            caller_func = ida_funcs.get_func(ref.frm)
            if caller_func:
                callers.append(caller_func.start_ea)
    return sorted(list(set(callers)))

def get_callees(func_ea):
    """获取当前函数调用的函数地址列表（向后兼容，不推荐使用）"""
    callees = []
    func = ida_funcs.get_func(func_ea)
    if not func:
        return callees
    
    for head in idautils.Heads(func.start_ea, func.end_ea):
        if idc.is_code(idc.get_full_flags(head)):
            for ref in idautils.XrefsFrom(head, 0):
                if ref.type in [ida_xref.fl_CF, ida_xref.fl_CN]:
                    callee_func = ida_funcs.get_func(ref.to)
                    if callee_func:
                        callees.append(callee_func.start_ea)
    return sorted(list(set(callees)))

def format_address_list(addr_list):
    """格式化地址列表为逗号分隔的十六进制字符串"""
    return ", ".join(map(hex, addr_list))

def export_decompiled_functions(export_dir, include_xrefs=True, skip_lib_funcs=False):
    """导出所有函数的反编译代码
    
    Args:
        export_dir: 导出目录
        include_xrefs: 是否包含调用关系（callers/callees），关闭可大幅提升性能
        skip_lib_funcs: 是否跳过库函数（如 CRT 函数等）
        
    Returns:
        (callers_map, callees_map): 如果include_xrefs=True，返回调用图字典；否则返回(None, None)
    """
    decompile_dir = os.path.join(export_dir, "decompile")
    ensure_dir(decompile_dir)
    
    total_funcs = 0
    exported_funcs = 0
    skipped_lib_funcs = 0
    failed_funcs = []
    
    # 批量收集所有函数地址，避免重复遍历
    print("[*] Collecting function list...")
    all_func_list = list(idautils.Functions())
    
    # 如果需要跳过库函数，先过滤函数列表
    if skip_lib_funcs:
        func_list = []
        for func_ea in all_func_list:
            func = ida_funcs.get_func(func_ea)
            if func and (func.flags & ida_funcs.FUNC_LIB):
                skipped_lib_funcs += 1
            else:
                func_list.append(func_ea)
        print("[*] Found {} functions, skipped {} library functions".format(
            len(all_func_list), skipped_lib_funcs))
    else:
        func_list = all_func_list
        print("[*] Found {} functions to process".format(len(func_list)))
    
    total_funcs = len(func_list)
    
    # 预先构建调用图（如果需要XRefs）
    if include_xrefs:
        callers_map, callees_map = build_call_graph(func_list)
    else:
        callers_map, callees_map = {}, {}
    
    for idx, func_ea in enumerate(func_list):
        func_name = idc.get_func_name(func_ea)
        
        try:
            dec_obj = ida_hexrays.decompile(func_ea)
            if dec_obj is None:
                failed_funcs.append((func_ea, func_name, "decompile returned None"))
                continue
            
            dec_str = str(dec_obj)
            
            # 从预构建的调用图中获取结果（O(1)查询）
            if include_xrefs:
                callers = callers_map.get(func_ea, [])
                callees = callees_map.get(func_ea, [])
            else:
                callers = []
                callees = []
            
            output_lines = []
            output_lines.append("/*")
            output_lines.append(" * func-name: {}".format(func_name))
            output_lines.append(" * func-address: {}".format(hex(func_ea)))
            output_lines.append(" * callers: {}".format(format_address_list(callers) if callers else "none"))
            output_lines.append(" * callees: {}".format(format_address_list(callees) if callees else "none"))
            output_lines.append(" */")
            output_lines.append("")
            output_lines.append(dec_str)
            
            output_filename = "{}.c".format(hex(func_ea))
            output_path = os.path.join(decompile_dir, output_filename)
            
            with open(output_path, 'w', encoding='utf-8') as f:
                f.write('\n'.join(output_lines))
            
            exported_funcs += 1
            
            # 更频繁的进度更新，带百分比
            if exported_funcs % 100 == 0:
                progress = (idx + 1) * 100.0 / total_funcs
                print("[+] Progress: {:.1f}% ({}/{}) functions exported...".format(
                    progress, exported_funcs, total_funcs))
                
        except Exception as e:
            failed_funcs.append((func_ea, func_name, str(e)))
            continue
    
    print("\n[*] Decompilation Summary:")
    print("    Total functions: {}".format(total_funcs))
    print("    Exported: {}".format(exported_funcs))
    print("    Failed: {}".format(len(failed_funcs)))
    
    if failed_funcs:
        failed_log_path = os.path.join(export_dir, "decompile_failed.txt")
        with open(failed_log_path, 'w', encoding='utf-8') as f:
            for addr, name, reason in failed_funcs:
                f.write("{} {} - {}\n".format(hex(addr), name, reason))
        print("    Failed list saved to: decompile_failed.txt")
    
    # 返回调用图（如果构建了的话）
    if include_xrefs:
        return callers_map, callees_map
    else:
        return None, None

def export_strings(export_dir):
    """导出所有字符串"""
    strings_path = os.path.join(export_dir, "strings.txt")
    
    string_count = 0
    with open(strings_path, 'w', encoding='utf-8') as f:
        f.write("# Strings exported from IDA\n")
        f.write("# Format: address | length | type | string\n")
        f.write("#" + "=" * 80 + "\n\n")
        
        for s in idautils.Strings():
            try:
                string_content = str(s)
                str_type = "ASCII"
                if s.strtype == ida_nalt.STRTYPE_C_16:
                    str_type = "UTF-16"
                elif s.strtype == ida_nalt.STRTYPE_C_32:
                    str_type = "UTF-32"
                
                f.write("{} | {} | {} | {}\n".format(
                    hex(s.ea),
                    s.length,
                    str_type,
                    string_content.replace('\n', '\\n').replace('\r', '\\r')
                ))
                string_count += 1
            except Exception as e:
                continue
    
    print("[*] Strings Summary:")
    print("    Total strings exported: {}".format(string_count))

def export_imports(export_dir):
    """导出导入表"""
    imports_path = os.path.join(export_dir, "imports.txt")
    
    import_count = 0
    with open(imports_path, 'w', encoding='utf-8') as f:
        f.write("# Imports\n")
        f.write("# Format: func-addr:func-name\n")
        f.write("#" + "=" * 60 + "\n\n")
        
        nimps = ida_nalt.get_import_module_qty()
        for i in range(nimps):
            module_name = ida_nalt.get_import_module_name(i)
            
            def imp_cb(ea, name, ordinal):
                nonlocal import_count
                if name:
                    f.write("{}:{}\n".format(hex(ea), name))
                else:
                    f.write("{}:ordinal_{}\n".format(hex(ea), ordinal))
                import_count += 1
                return True
            
            ida_nalt.enum_import_names(i, imp_cb)
    
    print("[*] Imports Summary:")
    print("    Total imports exported: {}".format(import_count))

def export_exports(export_dir):
    """导出导出表"""
    exports_path = os.path.join(export_dir, "exports.txt")
    
    export_count = 0
    with open(exports_path, 'w', encoding='utf-8') as f:
        f.write("# Exports\n")
        f.write("# Format: func-addr:func-name\n")
        f.write("#" + "=" * 60 + "\n\n")
        
        for i in range(ida_entry.get_entry_qty()):
            ordinal = ida_entry.get_entry_ordinal(i)
            ea = ida_entry.get_entry(ordinal)
            name = ida_entry.get_entry_name(ordinal)
            
            if name:
                f.write("{}:{}\n".format(hex(ea), name))
            else:
                f.write("{}:ordinal_{}\n".format(hex(ea), ordinal))
            export_count += 1
    
    print("[*] Exports Summary:")
    print("    Total exports exported: {}".format(export_count))

def export_structures(export_dir, detailed=True):
    """导出所有结构体定义（IDA 9.0+ 使用 ida_typeinf API）
    
    Args:
        export_dir: 导出目录
        detailed: 是否生成详细的单个文件，False时仅生成汇总文件
    """
    if not HAS_STRUCT_SUPPORT:
        print("[!] Structure export skipped: structure support not available")
        return
    
    structs_dir = os.path.join(export_dir, "structures")
    ensure_dir(structs_dir)
    
    print("[*] Collecting structure list...")
    
    # IDA 9.0+ 使用 ida_typeinf 直接遍历结构体
    struct_count, member_count = _export_structures_ida9(structs_dir, detailed)
    
    print("[*] Structures Summary:")
    print("    Total structures exported: {}".format(struct_count))
    print("    Total members: {}".format(member_count))
    print("    Output directory: structures/")
    print("    Summary file: _all_structures.txt")



def _export_structures_ida9(structs_dir, detailed):
    """IDA 9.0+ 版本的结构体导出，使用 ida_typeinf API"""
    struct_count = 0
    member_count = 0
    
    til = ida_typeinf.get_idati()
    
    # 使用 get_type_names() 遍历所有命名类型
    type_names = list(til.get_type_names())
    print("[*] Found {} named types, filtering for structures...".format(len(type_names)))
    
    # 创建汇总文件
    summary_path = os.path.join(structs_dir, "_all_structures.txt")
    
    with open(summary_path, 'w', encoding='utf-8') as summary_f:
        summary_f.write("# All Structures (IDA 9.0+ export)\n")
        summary_f.write("#" + "=" * 80 + "\n\n")
        
        for type_name in type_names:
            # 获取类型信息
            ti = til.get_named_type(type_name)
            if ti is None:
                continue
            
            # 只处理结构体和联合体
            if not (ti.is_struct() or ti.is_union()):
                continue
            
            struct_name = type_name
            struct_size = ti.get_size()
            if struct_size is None or struct_size < 0:
                struct_size = 0
            is_union = ti.is_union()
            
            struct_count += 1
            
            # 构建结构体定义
            struct_lines = []
            struct_lines.append("/*")
            struct_lines.append(" * Structure Name: {}".format(struct_name))
            struct_lines.append(" * Structure Size: {} bytes (0x{:X})".format(struct_size, struct_size))
            struct_lines.append(" */")
            struct_lines.append("")
            
            if is_union:
                struct_lines.append("union {}".format(struct_name))
            else:
                struct_lines.append("struct {}".format(struct_name))
            
            struct_lines.append("{")
            
            # 获取 UDT 成员
            udt = ida_typeinf.udt_type_data_t()
            if ti.get_udt_details(udt):
                for member in udt:
                    member_name = member.name if member.name else "field_{:X}".format(member.offset // 8)
                    member_offset = member.offset // 8  # 位偏移转字节偏移
                    member_size = member.size // 8 if member.size > 0 else (member.type.get_size() if member.type else 0)
                    
                    # 获取成员类型字符串
                    member_type_str = str(member.type) if member.type else ""
                    if not member_type_str:
                        member_type_str = "char[{}]".format(member_size) if member_size > 1 else "char"
                    
                    struct_lines.append("    {} {}; // offset: 0x{:X}, size: 0x{:X}".format(
                        member_type_str, member_name, member_offset, member_size
                    ))
                    
                    member_count += 1
            
            struct_lines.append("};")
            struct_lines.append("")
            
            struct_content = '\n'.join(struct_lines)
            
            # 只在详细模式下写入单独的结构体文件
            if detailed:
                # 清理文件名中的非法字符
                safe_name = "".join(c if c.isalnum() or c in "_-" else "_" for c in struct_name)
                # 限制文件名长度，避免 Windows 路径长度限制 (MAX_PATH = 260)
                # 保留最多 100 个字符，如果需要截断则添加哈希后缀确保唯一性
                MAX_FILENAME_LEN = 100
                if len(safe_name) > MAX_FILENAME_LEN:
                    name_hash = hashlib.md5(struct_name.encode('utf-8')).hexdigest()[:8]
                    safe_name = safe_name[:MAX_FILENAME_LEN - 9] + "_" + name_hash
                struct_filename = "{}.h".format(safe_name)
                struct_filepath = os.path.join(structs_dir, struct_filename)
                
                with open(struct_filepath, 'w', encoding='utf-8') as f:
                    f.write(struct_content)
            
            # 写入汇总文件
            summary_f.write(struct_content)
            summary_f.write("\n" + "-" * 80 + "\n\n")
            
            if struct_count % 50 == 0:
                print("[+] Exported {} structures...".format(struct_count))
    
    return struct_count, member_count


def export_call_graph(export_dir, callers_map, callees_map):
    """导出调用关系图到单独文件
    
    Args:
        export_dir: 导出目录
        callers_map: 调用者映射字典
        callees_map: 被调用者映射字典
    """
    callgraph_path = os.path.join(export_dir, "call_graph.txt")
    
    with open(callgraph_path, 'w', encoding='utf-8') as f:
        f.write("# Function Call Graph\n")
        f.write("# Format: func-addr:func-name -> [callees] <- [callers]\n")
        f.write("#" + "=" * 80 + "\n\n")
        
        # 按地址排序所有函数
        all_funcs = sorted(set(list(callers_map.keys()) + list(callees_map.keys())))
        
        for func_ea in all_funcs:
            func_name = idc.get_func_name(func_ea)
            callers = callers_map.get(func_ea, [])
            callees = callees_map.get(func_ea, [])
            
            f.write("{}:{}\n".format(hex(func_ea), func_name))
            
            if callees:
                f.write("  -> Calls: {}\n".format(
                    ", ".join(["{} ({})".format(hex(ea), idc.get_func_name(ea)) for ea in callees[:10]])
                ))
                if len(callees) > 10:
                    f.write("     ... and {} more\n".format(len(callees) - 10))
            
            if callers:
                f.write("  <- Called by: {}\n".format(
                    ", ".join(["{} ({})".format(hex(ea), idc.get_func_name(ea)) for ea in callers[:10]])
                ))
                if len(callers) > 10:
                    f.write("     ... and {} more\n".format(len(callers) - 10))
            
            f.write("\n")
    
    print("[*] Call Graph Summary:")
    print("    Total functions: {}".format(len(all_funcs)))
    print("    Output file: call_graph.txt")

def export_memory(export_dir, chunk_size_mb=1):
    """导出内存数据，按指定大小分割，hexdump 格式
    
    Args:
        export_dir: 导出目录
        chunk_size_mb: 每个文件的大小(MB)，默认1MB
    """
    memory_dir = os.path.join(export_dir, "memory")
    ensure_dir(memory_dir)
    
    CHUNK_SIZE = chunk_size_mb * 1024 * 1024
    BYTES_PER_LINE = 16
    BUFFER_SIZE = 4096  # 批量读取缓冲区
    
    total_bytes = 0
    file_count = 0
    
    for seg_idx in range(ida_segment.get_segm_qty()):
        seg = ida_segment.getnseg(seg_idx)
        if seg is None:
            continue
        
        seg_start = seg.start_ea
        seg_end = seg.end_ea
        seg_name = ida_segment.get_segm_name(seg)
        
        print("[*] Processing segment: {} ({} - {})".format(
            seg_name, hex(seg_start), hex(seg_end)))
        
        current_addr = seg_start
        while current_addr < seg_end:
            chunk_end = min(current_addr + CHUNK_SIZE, seg_end)
            
            filename = "{:08X}--{:08X}.txt".format(current_addr, chunk_end)
            filepath = os.path.join(memory_dir, filename)
            
            with open(filepath, 'w', encoding='utf-8') as f:
                f.write("# Memory dump: {} - {}\n".format(hex(current_addr), hex(chunk_end)))
                f.write("# Segment: {}\n".format(seg_name))
                f.write("#" + "=" * 76 + "\n\n")
                f.write("# Address        | Hex Bytes                                       | ASCII\n")
                f.write("#" + "-" * 76 + "\n")
                
                addr = current_addr
                lines_buffer = []  # 行缓冲区，减少写入次数
                while addr < chunk_end:
                    read_size = min(BUFFER_SIZE, chunk_end - addr)
                    buffer = ida_bytes.get_bytes(addr, read_size) or b'\x00' * read_size
                    
                    buf_offset = 0
                    while buf_offset < len(buffer) and addr < chunk_end:
                        line_chunk = buffer[buf_offset:buf_offset + BYTES_PER_LINE]
                        
                        # 高速格式化：使用 Python 内置 hex(' ') 方法
                        hex_part = line_chunk[:8].hex(' ').upper()
                        if len(line_chunk) > 8:
                            hex_part += "  " + line_chunk[8:].hex(' ').upper()
                        
                        # 使用预计算表加速 ASCII 转换
                        ascii_part = line_chunk.translate(_ASCII_TRANS).decode('ascii', errors='replace')
                        
                        lines_buffer.append("{:016X} | {} | {}\n".format(addr, hex_part.ljust(49), ascii_part))
                        
                        addr += len(line_chunk)
                        buf_offset += len(line_chunk)
                        total_bytes += len(line_chunk)
                        
                        # 批量写入
                        if len(lines_buffer) >= 1000:
                            f.write("".join(lines_buffer))
                            lines_buffer = []
                
                if lines_buffer:
                    f.write("".join(lines_buffer))
            
            file_count += 1
            current_addr = chunk_end
    
    print("\n[*] Memory Export Summary:")
    print("    Total bytes exported: {} ({:.2f} MB)".format(total_bytes, total_bytes / (1024*1024)))
    print("    Files created: {}".format(file_count))

def main():
    """主函数"""
    print("=" * 60)
    print("IDA Export for AI Analysis (Optimized)")
    print("=" * 60)
    
    # 性能优化选项
    INCLUDE_XREFS = True  # 是否包含调用关系（callers/callees），关闭可大幅提速
    EXPORT_CALL_GRAPH = True  # 是否单独导出调用关系图文件
    DETAILED_STRUCTS = True  # 是否为每个结构体生成单独文件
    MEMORY_CHUNK_MB = 1  # 内存导出文件大小(MB)
    SKIP_MEMORY = False  # 是否跳过内存导出（内存导出通常最耗时）
    SKIP_STRINGS = False  # 是否跳过字符串导出
    SKIP_STRUCTURES = False  # 是否跳过结构体导出
    SKIP_LIB_FUNCTIONS = True  # 是否跳过库函数（如 CRT 函数等）
    
    print("[*] Performance Settings:")
    print("    Include XRefs: {}".format(INCLUDE_XREFS))
    print("    Export Call Graph: {}".format(EXPORT_CALL_GRAPH))
    print("    Detailed Structures: {}".format(DETAILED_STRUCTS))
    print("    Memory Chunk Size: {} MB".format(MEMORY_CHUNK_MB))
    print("    Skip Memory: {}".format(SKIP_MEMORY))
    print("    Skip Library Functions: {}".format(SKIP_LIB_FUNCTIONS))
    print("")
    
    if not ida_hexrays.init_hexrays_plugin():
        print("[!] Hex-Rays decompiler is not available!")
        print("[!] Strings will still be exported, but no decompilation.")
        has_hexrays = False
    else:
        has_hexrays = True
        print("[+] Hex-Rays decompiler initialized")
    
    idb_dir = get_idb_directory()
    input_file = ida_nalt.get_input_file_path()
    if input_file:
        file_name_with_ext = os.path.basename(input_file)
        export_dir_name = "{}-export".format(file_name_with_ext)
    else:
        export_dir_name = "export-for-ai"
        
    export_dir = os.path.join(idb_dir, export_dir_name)
    ensure_dir(export_dir)
    
    print("[+] Export directory: {}".format(export_dir))
    print("")
    
    if not ida_auto.auto_is_ok():
        print("[!] Warning: IDA is still performing initial analysis. Performance may be degraded.")

    import time
    start_time = time.time()
    
    if not SKIP_STRINGS:
        print("[*] Exporting strings...")
        t = time.time()
        export_strings(export_dir)
        print("    Completed in {:.2f} seconds".format(time.time() - t))
        print("")
    
    print("[*] Exporting imports...")
    t = time.time()
    export_imports(export_dir)
    print("    Completed in {:.2f} seconds".format(time.time() - t))
    print("")
    
    print("[*] Exporting exports...")
    t = time.time()
    export_exports(export_dir)
    print("    Completed in {:.2f} seconds".format(time.time() - t))
    print("")
    
    if not SKIP_STRUCTURES:
        print("[*] Exporting structures...")
        t = time.time()
        export_structures(export_dir, detailed=DETAILED_STRUCTS)
        print("    Completed in {:.2f} seconds".format(time.time() - t))
        print("")
    
    if not SKIP_MEMORY:
        print("[*] Exporting memory...")
        t = time.time()
        export_memory(export_dir, chunk_size_mb=MEMORY_CHUNK_MB)
        print("    Completed in {:.2f} seconds".format(time.time() - t))
        print("")
    
    if has_hexrays:
        print("[*] Exporting decompiled functions...")
        t = time.time()
        callers_map, callees_map = export_decompiled_functions(export_dir, include_xrefs=INCLUDE_XREFS, skip_lib_funcs=SKIP_LIB_FUNCTIONS)
        print("    Completed in {:.2f} seconds".format(time.time() - t))
        
        # 如果启用了XRefs并且需要导出调用图
        if INCLUDE_XREFS and EXPORT_CALL_GRAPH and callers_map and callees_map:
            print("")
            print("[*] Exporting call graph...")
            t = time.time()
            export_call_graph(export_dir, callers_map, callees_map)
            print("    Completed in {:.2f} seconds".format(time.time() - t))
    
    print("")
    total_time = time.time() - start_time
    print("=" * 60)
    print("[+] Export completed!")
    print("    Output directory: {}".format(export_dir))
    print("    Total time: {:.2f} seconds ({:.2f} minutes)".format(total_time, total_time / 60))
    print("=" * 60)

if __name__ == "__main__":
    main()