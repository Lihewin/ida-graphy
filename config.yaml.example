# IDA-Graphy Configuration File
# =============================================================================

# IDA Installation Settings
ida:
  # Path to IDA Pro installation directory
  path: "C:\\Program Files\\IDA Professional 9.2"

  # Path to idalib Python bindings (usually under IDA installation)
  idalib_python: "C:\\Program Files\\IDA Professional 9.2\\idalib\\python"

# Export Settings
export:
  # Enable file export (decompiled code, structures, etc.)
  # Requires Hex-Rays decompiler plugin
  enable_file_export: true

  # Ghidra fallback is used only for functions Hex-Rays rejects due to hard
  # limits such as "stack frame is too big". Requires Java/JDK on PATH or JAVA_HOME.
  ghidra_fallback:
    path: "/opt/ghidra"
    # Optional: override the analyzeHeadless executable path directly.
    # analyze_headless: "/opt/ghidra/support/analyzeHeadless"

# Analysis Options
analysis:
  # Enable dataflow analysis (READS/WRITES edges)
  enable_dataflow: true

# Project Management Settings
projects:
  # Root directory for all projects
  root_dir: "projects"

# Logging Settings
logging:
  # Save logs to file
  file: "ida_graphy.log"
